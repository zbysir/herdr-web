# 部署配置。cp .env.example .env 之后改，`make run` 会读它；
# 装成常驻服务是 `herdr-web service install --env-file .env`。
# 这里每一项都带 HERDR_WEB_ 前缀，DNS 凭据也一样 —— install 抄进 plist / unit 的就是
# 这个前缀下的全部变量，没有前缀的抄不进去（见 DEPLOY.md）。
# 每一项在挡什么、砍掉之后会怎样，见 DEPLOY.md。
# 不填任何东西也能跑：默认只听 127.0.0.1，够本机自己用。

# ── 听哪儿 ───────────────────────────────────────────────────────────
#HERDR_WEB_HOST=0.0.0.0        # 开局域网。非本机地址没有 TLS 会拒绝启动
#HERDR_WEB_PORT=7788

# ── 公网暴露（走 frp / 隧道 / 端口转发时**必须**声明）────────────────
# 为什么必须手动说：走穿透时 herdr-web 往往只监听 127.0.0.1，「监听地址是不是本机」
# 这个判据完全失效 —— 看起来最安全的配置实际挂在整个互联网上，程序自己测不出来。
#HERDR_WEB_EXPOSED=1

# ── TLS ──────────────────────────────────────────────────────────────
# 三选一：
#   1) 自己有真证书（最省事，浏览器零警告，passkey 可用）
#HERDR_WEB_TLS_CERT=/path/fullchain.pem
#HERDR_WEB_TLS_KEY=/path/privkey.pem
#   2) **让 herdr-web 自己去签**（推荐：不用装反代、不用手动续期）
#      走 DNS-01，所以不需要外网能连进来 —— 家宽 NAT 后面、甚至把域名的 A 记录指到
#      内网地址（192.168.x.x）都签得出来。凭据只从环境变量读，不落盘。
#HERDR_WEB_ACME_DNS=cloudflare     # cloudflare / alidns / tencentcloud / route53 / digitalocean / huaweicloud
#HERDR_WEB_ACME_EMAIL=you@example.com
#HERDR_WEB_ACME_STAGING=1          # 调试时**一定先开这个**：正式环境同一组域名一周只给 5 张
#   各家 token 怎么拿、该给多小的权限：见 DNS.md
#   各家要的凭据（照抄到下面）：
#HERDR_WEB_CLOUDFLARE_DNS_API_TOKEN=   # Zone:DNS:Edit 权限
#HERDR_WEB_ALICLOUD_ACCESS_KEY=
#HERDR_WEB_ALICLOUD_SECRET_KEY=
#HERDR_WEB_TENCENTCLOUD_SECRET_ID=
#HERDR_WEB_TENCENTCLOUD_SECRET_KEY=
#HERDR_WEB_AWS_ACCESS_KEY_ID=
#HERDR_WEB_AWS_SECRET_ACCESS_KEY=
#HERDR_WEB_AWS_REGION=
#HERDR_WEB_DO_AUTH_TOKEN=
#HERDR_WEB_HUAWEICLOUD_ACCESS_KEY_ID=
#HERDR_WEB_HUAWEICLOUD_SECRET_ACCESS_KEY=
#HERDR_WEB_HUAWEICLOUD_REGION=
#   3) 自签（每台设备第一次点一下「继续访问」）
#HERDR_WEB_TLS=auto
#   3) 前面有反代帮你终止 TLS（nginx / Traefik / Caddy）
#HERDR_WEB_TLS=proxy

# 允许出现在 Host 头里的域名，逗号分隔。**不在名单里的域名直接 421**——
# 这是 DNS rebinding 的唯一防线。用 IP 访问不需要配。
#HERDR_WEB_HOSTNAME=herdr.example.com
# 你实际访问的地址。公网端口和本地端口不一样时必给，不然横幅里的二维码是废的。
#HERDR_WEB_PUBLIC_URL=https://herdr.example.com:12345

# 只有在**确认公网唯一入口就是那个反代**之后才开 —— 否则谁都能自带一个
# X-Forwarded-For 伪造来源 IP，把限速绕干净。
#HERDR_WEB_TRUST_PROXY=1

# ── 局域网直连 ───────────────────────────────────────────────────────
# 走隧道时每个字都是两跳公网（设备 → VPS → 这台）。人和这台机器常常就在同一个
# Wi-Fi 上，那一趟是白绕。开了这个口之后：从公网地址打开的页面会嗅探一下能不能
# 直连，能就问一次「切过去？」，同意之后再遇到就静默切。书签不用改。
#
# 这个口自己带**自签** TLS（不能是明文：https 页面对 http 目标的 fetch 算 active
# mixed content，浏览器一律拦死，连嗅探都发不出去）。所以每台设备要先手动开一次
# https://<内网IP>:7790/ 点「继续访问」；不点的话嗅探在 TLS 握手就失败，页面安静
# 留在隧道那条路上。想免掉这一步就把 ~/.herdr-web/tls/ca.pem 装到设备上。
#
# 别和主口 / 管理口（主口+1）撞，撞了会拒绝启动。细节见 DEPLOY.md。
#HERDR_WEB_LAN_PORT=7790

# ── 凭据 ─────────────────────────────────────────────────────────────
#HERDR_WEB_DEVICE_TTL_DAYS=90  # 设备凭据多久不活跃就失效（每次用都续期）。0 = 永不过期
#HERDR_WEB_REAUTH_HOURS=24     # 注册过 passkey 之后多久要重验一次。0 = 不要求
#HERDR_WEB_LEGACY_TOKEN=off    # 旧 ?token= 链接：on / loopback / off。迁移完就该 off 或删掉 token 文件
#HERDR_WEB_TRUST_LOOPBACK=1    # 本机免配对。**套 frp / 反代时千万别开**，那时候公网请求的源地址也是 127.0.0.1

# ── 别的 ─────────────────────────────────────────────────────────────
#HERDR_WEB_ONCONNECT=herdr     # 连上自动敲的那一行，空串就不敲
#HERDR_WEB_SOCKET=/path/herdr.sock

# 自动查更新（默认开）。关掉之后这个进程不会有任何出站请求。
# HERDR_WEB_UPDATE_CHECK=0

# 文件浏览（默认开）。看 agent 生成的图：终端里点那行路径，或者顶栏 📁。
#HERDR_WEB_FILES=0
# 配了才是**真白名单**（jail），只能看这几棵树；空 = 不设边界。
# 默认不设边界是因为能开这个页面的人已经有一个登录 shell，白名单挡不住他，
# 只会天天挡路（agent 往 /tmp、/var/folders/… 写图是常态）。见 README「文件浏览」。
#HERDR_WEB_FILE_ROOTS=/Users/me/work,/tmp
