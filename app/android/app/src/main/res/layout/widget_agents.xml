<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小部件：agent 状态一览。和常驻通知那份是同一份数据、同一套挑法（Agents.kt） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_notify"
            android:tint="#3ECF8E" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="herdr"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/when"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#737373"
            android:textSize="11sp" />
    </LinearLayout>

    <!--
      六行是**写死的**、每个控件 id 都不一样（r1_st … r6_what），不是代码里 addView 同一个
      widget_row 进来：小米 HyperOS 的桌面是 Flutter 自己重新实现的 RemoteViews 渲染，按 view id
      认控件，几行用同一套 id 时它会认错、把旧行的字留着 —— 表现是「数量对了、正文没更新」
      （真机上撞到的，通知栏由系统界面画，没这个问题）。
    -->
    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/r1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/r1_st"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/r1_what"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E5E5E5"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/r2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/r2_st"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/r2_what"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E5E5E5"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/r3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/r3_st"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/r3_what"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E5E5E5"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/r4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/r4_st"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/r4_what"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E5E5E5"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/r5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/r5_st"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/r5_what"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E5E5E5"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/r6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal"
            android:paddingVertical="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/r6_st"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/r6_what"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#E5E5E5"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#737373"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
