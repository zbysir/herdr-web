# Go 产物
/herdr-web

# 前端依赖和构建产物
web/node_modules/
web/dist/
# tsc -b 的增量编译缓存。**绝不能入库**：make test 每跑一次就改写它，于是
# goreleaser 判定「git is in a dirty state」直接拒绝发版（实测在 v0.1.0 上挂过一次）。
web/tsconfig.tsbuildinfo
# 嵌进二进制的那份由 make build 生成，只留占位
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# 主机数据、token 都在 ~/.herdr-web/，本来就不在仓库里；
# 万一有人把数据目录指到项目下（HERDR_WEB_DIR），也别让它进版本库
.herdr-web/
token

# 本机的部署配置（域名、证书路径这些），.env.example 是入库的模板
.env

.DS_Store
*.log

# reference/ 里的 Python 原型
__pycache__/
*.pyc

# 发版产物（goreleaser）
/dist/
# npm 包：根包（那个 JS 壳）是入库要维护的，平台子包和拷进去的 README 都是生成的
/npm/herdr-web-*/
/npm/herdr-web/README.md
